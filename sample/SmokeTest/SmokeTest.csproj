<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>MinimalOpenAPI.Samples.SmokeTest</RootNamespace>
  </PropertyGroup>

  <!--
    Consume MinimalOpenAPI as a NuGet package, not via a project reference.
    This is the whole point of the smoke test: verify the packed artifact works
    exactly as a real downstream consumer would experience it.

    The package version is injectable so release validation can require the exact
    version produced by the current workflow. It defaults to *-* for ordinary
    local/CI smoke-test use. The release workflow passes its calculated version
    explicitly and verifies that exact version in project.assets.json.

    The MinimalOpenAPI package bundles both the source generator and the runtime
    services, so no additional package references are needed.
  -->
  <PropertyGroup>
    <MinimalOpenAPIVersion Condition="'$(MinimalOpenAPIVersion)' == ''">*-*</MinimalOpenAPIVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinimalOpenAPI" Version="$(MinimalOpenAPIVersion)" />
  </ItemGroup>

  <ItemGroup>
    <OpenApi Include="openapi.yaml"
             PublishAs="/openapi/schema.yaml"
             DisplayName="Smoke Test API"
             DisplayVersion="1.0.0" />
  </ItemGroup>

</Project>
