<Project>
  <!--
    Standalone package consumer: shadows the repo-wide Directory.Build.props so that no MinVer
    versioning, central package management or other repo build customisations apply.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Injectable like sample/SmokeTest; defaults to the newest package in artifacts/. -->
    <MinimalOpenAPIVersion Condition="'$(MinimalOpenAPIVersion)' == ''">*-*</MinimalOpenAPIVersion>
  </PropertyGroup>
</Project>
