<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Contracts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MinimalOpenAPI" Version="$(MinimalOpenAPIVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../ClassLibrary/Catalog/*.cs" />
    <!-- Generate spelled out (it is the default) to exercise the ';'-separated form through the package. -->
    <OpenApi Include="../../ClassLibrary/Catalog/catalog.yaml" Namespace="Catalog" Generate="Contracts;Endpoints" />
  </ItemGroup>

</Project>
