<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Generated code must not rely on implicit usings (#126). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- "Contracts" also names a generated namespace segment (#125). -->
    <RootNamespace>Contracts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    In the NuGet scenario a consumer would have:
      <PackageReference Include="MinimalOpenAPI" />
    and the build/buildTransitive targets would be imported automatically.
    In this project-reference dev scenario we import the targets explicitly.
  -->
  <Import Project="../../../src/MinimalOpenAPI/buildTransitive/MinimalOpenAPI.targets" />

  <ItemGroup>
    <OpenApi Include="catalog.yaml" Namespace="Catalog" PublishAs="/openapi/catalog.yaml" />
  </ItemGroup>

</Project>
