<Project>
  <!--
    MSBuild targets shipped with the MinimalOpenAPI package.

    In the NuGet package scenario this file is imported automatically by the
    .NET SDK from build/ and buildTransitive/.

    In the project-reference development scenario the consuming project imports
    it explicitly:

      <Import Project="../../src/MinimalOpenAPI.Generator/buildTransitive/MinimalOpenAPI.targets" />

    Responsibilities:
      1. Forward <OpenApi Include="…" /> items to AdditionalFiles with the
         MinimalOpenApiFile metadata so the generator can see them.
      2. Add MinimalOpenAPI as a Roslyn analyzer (dev scenario only).
      3. Add the generator's runtime dependencies as analyzers so Roslyn can
         load the generator DLL (dev scenario only).
      4. Add MinimalOpenAPI.Runtime as a compile reference (dev scenario only).
      5. Copy all <OpenApi /> files to the build output directory and include
         them in dotnet publish output under openapi/schemas/<SchemaId>/<name>.<ext>.
  -->

  <!-- ── OpenApi item type ────────────────────────────────────────────── -->
  <ItemDefinitionGroup>
    <MinimalOpenApiHandler>
      <OpenApiFile></OpenApiFile>
      <IncludeStatusCodes></IncludeStatusCodes>
      <ExcludeStatusCodes></ExcludeStatusCodes>
    </MinimalOpenApiHandler>
  </ItemDefinitionGroup>
  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiFile" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiNamespace" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiSchemaId" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiPublishAs" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiDisplayName" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiDisplayVersion" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiReadWriteSchemaHandling" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiGenerate" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiExcludeStatusCodesFromHandlers" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiFileIdentity" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiHandler" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiHandlerOpenApiFile" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiHandlerInclude" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiHandlerIncludeStatusCodes" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="MinimalOpenApiHandlerExcludeStatusCodes" />
    <CompilerVisibleProperty Include="RootNamespace" />
    <!-- Libraries defer the missing-handler check (MOA001) to the application that references them. -->
    <CompilerVisibleProperty Include="OutputType" />
    <CompilerVisibleProperty Include="IsTestProject" />
  </ItemGroup>

  <!--
    Transfer <OpenApi> items to AdditionalFiles with the MinimalOpenApiFile
    metadata flag set.  Must run before GenerateMSBuildEditorConfigFileCore so
    that the metadata is included in the generated analyzer config file that
    Roslyn reads via AnalyzerConfigOptions.

    The optional Namespace item metadata (e.g. <OpenApi Include="payment.yaml" Namespace="Payment" />)
    is forwarded as MinimalOpenApiNamespace.  When absent, the generator derives
    a PascalCase name from the file name (e.g. payment-api.yaml → PaymentApi).

    MinimalOpenApiSchemaId is a stable integer hash of the item's full source path.
    It is used as a unique subdirectory when copying publishable spec files to the
    build output (openapi/schemas/<SchemaId>/<filename>.<ext>), preventing collisions
    between spec files that share the same filename but come from different directories
    or NuGet packages.  The value is non-deterministic across machines (because full
    paths differ), which is intentional and acceptable since the files are never
    checked in.  The generator receives the same value so it can hard-code the correct
    relative file path inside the generated RegisterSchemaFile() call.

    MinimalOpenApiPublishAs / MinimalOpenApiDisplayName / MinimalOpenApiDisplayVersion
    mirror the matching OpenApi item metadata so the generator can register runtime
    schema mapping metadata without parsing file contents.

    MinimalOpenApiReadWriteSchemaHandling mirrors OpenApi.ReadWriteSchemaHandling and
    controls request/response DTO scoping for readOnly/writeOnly properties.

    Semicolon-separated status codes use '|' in compiler-visible metadata because
    the generated .editorconfig treats ';' as an inline comment delimiter.
  -->
  <Target Name="AddMinimalOpenApiFilesToAdditionalFiles"
          BeforeTargets="GenerateMSBuildEditorConfigFileCore;CoreCompile">
    <ItemGroup>
      <AdditionalFiles Include="@(OpenApi)"
                       MinimalOpenApiFile="true"
                       MinimalOpenApiFileIdentity="%(OpenApi.Identity)"
                       MinimalOpenApiNamespace="%(OpenApi.Namespace)"
                       MinimalOpenApiSchemaId="$([System.Math]::Abs($([MSBuild]::StableStringHash('%(FullPath)'))))"
                       MinimalOpenApiPublishAs="%(OpenApi.PublishAs)"
                       MinimalOpenApiDisplayName="%(OpenApi.DisplayName)"
                       MinimalOpenApiDisplayVersion="%(OpenApi.DisplayVersion)"
                       MinimalOpenApiReadWriteSchemaHandling="%(OpenApi.ReadWriteSchemaHandling)"
                       MinimalOpenApiGenerate="$([System.String]::Copy('%(OpenApi.Generate)').Replace('%3B', '|').Replace(';', '|'))"
                       MinimalOpenApiExcludeStatusCodesFromHandlers="$([System.String]::Copy('%(OpenApi.ExcludeStatusCodesFromHandlers)').Replace('%3B', '|'))" />
    </ItemGroup>
    <ItemGroup>
      <_MinimalOpenApiHandlerFile Include="@(MinimalOpenApiHandler)"
                                  IdentityHash="$([MSBuild]::StableStringHash('%(Identity)|%(OpenApiFile)|%(IncludeStatusCodes)|%(ExcludeStatusCodes)'))"
                                  MinimalOpenApiHandler="true"
                                  MinimalOpenApiHandlerOpenApiFile="%(OpenApiFile)"
                                  MinimalOpenApiHandlerInclude="%(Identity)"
                                  MinimalOpenApiHandlerIncludeStatusCodes="$([System.String]::Copy('%(IncludeStatusCodes)').Replace('%3B', '|'))"
                                  MinimalOpenApiHandlerExcludeStatusCodes="$([System.String]::Copy('%(ExcludeStatusCodes)').Replace('%3B', '|'))" />
      <AdditionalFiles Include="@(_MinimalOpenApiHandlerFile->'$(IntermediateOutputPath)MinimalOpenApiHandler/%(IdentityHash).txt')"
                       MinimalOpenApiHandler="%(_MinimalOpenApiHandlerFile.MinimalOpenApiHandler)"
                       MinimalOpenApiHandlerOpenApiFile="%(_MinimalOpenApiHandlerFile.MinimalOpenApiHandlerOpenApiFile)"
                       MinimalOpenApiHandlerInclude="%(_MinimalOpenApiHandlerFile.MinimalOpenApiHandlerInclude)"
                       MinimalOpenApiHandlerIncludeStatusCodes="%(_MinimalOpenApiHandlerFile.MinimalOpenApiHandlerIncludeStatusCodes)"
                       MinimalOpenApiHandlerExcludeStatusCodes="%(_MinimalOpenApiHandlerFile.MinimalOpenApiHandlerExcludeStatusCodes)" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)MinimalOpenApiHandler/%(_MinimalOpenApiHandlerFile.IdentityHash).txt"
                      Lines=""
                      Overwrite="true"
                      Condition="'@(_MinimalOpenApiHandlerFile)' != ''" />
  </Target>

  <!-- ── PublishAs validation ─────────────────────────────────────────── -->
  <!--
    Validate that PublishAs starts with '/' when provided.
  -->
  <Target Name="ValidateMinimalOpenApiPublishAsStartsWithSlash"
          BeforeTargets="Build">
    <Error Condition="'%(OpenApi.PublishAs)' != '' and !$([System.String]::Copy('%(OpenApi.PublishAs)').StartsWith('/'))"
           Text="OpenApi item '%(OpenApi.Identity)' has PublishAs='%(OpenApi.PublishAs)'. PublishAs must start with '/'." />
  </Target>

  <!--
    Validate that no two OpenApi items share the same PublishAs value.
  -->
  <Target Name="ValidateMinimalOpenApiPublishAsDuplicates"
          BeforeTargets="Build">
    <ItemGroup>
      <_OpenApiWithPublishAs Include="@(OpenApi)" Condition="'%(OpenApi.PublishAs)' != ''" />
      <_OpenApiPublishAsValues Include="@(_OpenApiWithPublishAs->'%(PublishAs)')" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_OpenApiPublishAsValues)">
      <Output TaskParameter="Filtered" ItemName="_UniquePublishAsValues" />
    </RemoveDuplicates>
    <Error Condition="@(_OpenApiPublishAsValues->Count()) != @(_UniquePublishAsValues->Count())"
           Text="Duplicate PublishAs values found across OpenApi items: '@(_OpenApiPublishAsValues)'. Each PublishAs must be unique." />
  </Target>

  <!-- ── Project-reference development scenario ──────────────────────── -->
  <!--
    Paths below resolve relative to THIS targets file so they work regardless
    of where the consuming project lives in the repo.
  -->
  <PropertyGroup>
    <_MinimalOpenApiProj>$(MSBuildThisFileDirectory)..\MinimalOpenAPI.csproj</_MinimalOpenApiProj>
    <_MinimalOpenApiGenDir>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\netstandard2.0\</_MinimalOpenApiGenDir>
  </PropertyGroup>

  <!--
    Add MinimalOpenAPI as a Roslyn analyzer so the IIncrementalGenerator runs
    during compilation.  The Condition ensures this only applies when the
    project file exists on disk (dev scenario); in the NuGet scenario the
    generator DLL is already in analyzers/dotnet/cs/ of the package.

    Properties="TargetFramework=netstandard2.0": MinimalOpenAPI is multi-targeted
    (netstandard2.0 + net10.0).  Without this override MSBuild picks the net10.0
    TFM for a net10.0 consumer, loading net10.0/MinimalOpenAPI.dll as the analyzer.
    That DLL depends on Microsoft.AspNetCore.App, which Roslyn's isolated
    AssemblyLoadContext cannot load, causing a FileNotFoundException and a silent
    generator initialization failure.  Forcing netstandard2.0 ensures Roslyn
    always receives the netstandard2.0 analyzer DLL regardless of the consumer's TFM.
  -->
  <ItemGroup>
    <ProjectReference Include="$(_MinimalOpenApiProj)"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      Properties="TargetFramework=netstandard2.0"
                      Condition="Exists('$(_MinimalOpenApiProj)')" />
  </ItemGroup>

  <!--
    Add MinimalOpenAPI (net10.0 build) as a compile reference so the consuming
    project can use AddMinimalOpenApi(), MapMinimalOpenApiEndpoints(), and the
    other runtime APIs.
    In the NuGet scenario lib/net10.0/MinimalOpenAPI.dll is added automatically.
  -->
  <ItemGroup>
    <ProjectReference Include="$(_MinimalOpenApiProj)"
                      Properties="TargetFramework=net10.0"
                      Condition="Exists('$(_MinimalOpenApiProj)')" />
  </ItemGroup>

  <!--
    Add the generator's runtime dependencies as analyzers so Roslyn can load
    the generator DLL in its isolated AssemblyLoadContext.

    These items are placed inside a <Target> (not a static <ItemGroup>) so the
    Exists() check runs at *build execution time* — after the generator project
    and its dependencies have already been compiled — rather than at project
    evaluation time when a fresh CI checkout would have no bin/ output yet.
  -->
  <Target Name="AddMinimalOpenApiGeneratorDependencyAnalyzers"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Include="$(_MinimalOpenApiGenDir)MinimalOpenAPI.Abstractions.dll"
                Condition="Exists('$(_MinimalOpenApiGenDir)MinimalOpenAPI.Abstractions.dll')" />
      <Analyzer Include="$(_MinimalOpenApiGenDir)MinimalOpenAPI.Parser.Yaml.dll"
                Condition="Exists('$(_MinimalOpenApiGenDir)MinimalOpenAPI.Parser.Yaml.dll')" />
      <Analyzer Include="$(_MinimalOpenApiGenDir)MinimalOpenAPI.Parser.Json.dll"
                Condition="Exists('$(_MinimalOpenApiGenDir)MinimalOpenAPI.Parser.Json.dll')" />
      <Analyzer Include="$(_MinimalOpenApiGenDir)YamlDotNet.dll"
                Condition="Exists('$(_MinimalOpenApiGenDir)YamlDotNet.dll')" />
    </ItemGroup>
  </Target>

  <!-- ── OpenAPI file publishing ─────────────────────────────────────── -->
  <!--
    Ship every <OpenApi /> file that generates Endpoints (the layer that registers the schema file)
    with the build and publish output, under a unique subdirectory derived from a stable hash of its
    full source path. Files with the same name from different directories, projects or packages
    therefore never collide.
    Destination (relative to the output / publish root): openapi/schemas/<SchemaId>/<filename>.<extension>
    Examples:
      /repo/openapi.yaml (hash 987654321)  →  openapi/schemas/987654321/openapi.yaml
      /pkg/v2/openapi.yaml (hash 123456789) →  openapi/schemas/123456789/openapi.yaml

    The files are added as ContentWithTargetPath items with CopyToOutputDirectory and
    CopyToPublishDirectory, the SDK's standard "copy this file" mechanism. The SDK copies them to this
    project's output and publish directories, and also to those of every project referencing it
    (GetCopyToOutputDirectoryItems / GetCopyToPublishDirectoryItems are transitive), so a host that
    references a library declaring a document serves the library's authored document without any
    extra items. The target runs before AssignTargetPaths, which both this project's build and the
    referencing project's calls into this project depend on.
  -->
  <Target Name="AddMinimalOpenApiFilesToOutput"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="CopyMinimalOpenApiFilesToOutput"
          Condition="'@(OpenApi)' != ''">
    <ItemGroup>
      <_MinimalOpenApiOutputFile Include="@(OpenApi->'%(FullPath)')"
                                 Condition="'%(OpenApi.Generate)' == '' or $([System.String]::Copy('%(OpenApi.Generate)').ToLowerInvariant().Contains('endpoints'))">
        <SchemaId>$([System.Math]::Abs($([MSBuild]::StableStringHash('%(FullPath)'))))</SchemaId>
      </_MinimalOpenApiOutputFile>
      <ContentWithTargetPath Include="@(_MinimalOpenApiOutputFile)"
                             TargetPath="openapi/schemas/%(_MinimalOpenApiOutputFile.SchemaId)/%(_MinimalOpenApiOutputFile.Filename)%(_MinimalOpenApiOutputFile.Extension)"
                             CopyToOutputDirectory="PreserveNewest"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Formerly the target that copied the files after Build. Kept, empty, so that project targets hooked
    with BeforeTargets="CopyMinimalOpenApiFilesToOutput" (for example to update <OpenApi> metadata)
    still run before the files are added to the output.
  -->
  <Target Name="CopyMinimalOpenApiFilesToOutput" />

</Project>
