<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>MinimalOpenAPIClient.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <OpenApiClient Include="client-test.yaml" />
    <OpenApiClient Include="contracts/one/shared.yaml"
                   Namespace="MinimalOpenAPIClient.IntegrationTests.Clients.SharedOne" />
    <OpenApiClient Include="contracts/two/shared.yaml"
                   Namespace="MinimalOpenAPIClient.IntegrationTests.Clients.SharedTwo" />
  </ItemGroup>

  <Import Project="../../src/MinimalOpenAPI.Client/buildTransitive/MinimalOpenAPI.Client.targets" />

</Project>