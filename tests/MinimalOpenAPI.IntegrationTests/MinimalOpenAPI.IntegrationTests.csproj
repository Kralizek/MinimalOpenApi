<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../src/MinimalOpenAPI/buildTransitive/MinimalOpenAPI.targets" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../sample/BasicTodo/BasicTodo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <OpenApi Include="filtered-responses.yaml" ExcludeStatusCodesFromHandlers="401" />
    <MinimalOpenApiHandler Include="getFiltered" OpenApiFile="filtered-responses.yaml"
                           IncludeStatusCodes="403" ExcludeStatusCodes="403" />
  </ItemGroup>

</Project>
